# Placeholders only. Never commit the real .env file.
# Owner credential: direct host, used only in scripts/migrate.ts.
DATABASE_URL_ADMIN=postgresql://neondb_owner:<owner-password>@<direct-host>/<database>?sslmode=require
# Runtime credential: pooler host, restricted SQL-created app_login role.
DATABASE_URL=postgresql://app_login:<app-login-password>@<pooler-host>/<database>?sslmode=require
APP_LOGIN_PASSWORD=<random-password-at-least-24-characters>
JWT_SECRET=<random-secret-at-least-32-characters>
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=<groq-model-supporting-json-mode>
CORS_ORIGIN=http://<frontend-host>:<frontend-port>
PORT=<api-port>
NODE_ENV=<development-or-production>
# Optional, explicitly separate disposable Neon branch or local test server.
TEST_DATABASE_URL=postgresql://<test-owner>:<test-password>@<test-host>/<test-database>?sslmode=require
TEST_POSTGRES_PASSWORD=<random-local-test-password>
# JSON arrays; corresponding elements have matching indexes. No default users.
REVIEWER_EMAILS=["<reviewer-email>"]
REVIEWER_PASSWORDS=["<reviewer-password-at-least-12-characters>"]
DEMO_REVIEWER_EMAIL=<existing-allowlisted-reviewer-email>
