{
  "name": "streamtrace",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:core && npm run test:ui",
    "typecheck": "tsc --noEmit",
    "benchmark": "node --experimental-strip-types benchmarks/run.ts",
    "test:rls": "bash scripts/test-rls.sh",
    "geojson": "node --experimental-strip-types scripts/to-geojson.ts",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:core": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.19.6",
    "typescript": "5.9.3",
    "vite": "7.3.3",
    "vitest": "4.1.9",
    "jsdom": "29.1.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/leaflet": "1.9.21"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "leaflet": "1.9.4"
  }
}
