{
  "name": "streamtrace",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:core && npm run test:ui && npm run test:api && npm run check:repository",
    "typecheck": "tsc --noEmit",
    "benchmark": "node --experimental-strip-types benchmarks/run.ts",
    "test:rls": "node --experimental-strip-types scripts/test-rls.ts",
    "geojson": "node --experimental-strip-types scripts/to-geojson.ts",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:core": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "vitest run",
    "api": "node --experimental-strip-types api/server.ts",
    "migrate": "node --experimental-strip-types scripts/migrate.ts",
    "seed:reviewers": "node --experimental-strip-types scripts/seed-reviewers.ts",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo.ts",
    "setup:citizen": "node --experimental-strip-types scripts/setup-citizen-cases.ts",
    "test:api": "node --experimental-strip-types --test api/tests/*.test.ts",
    "check:runtime": "node --experimental-strip-types scripts/check-runtime.ts",
    "check:repository": "node --experimental-strip-types scripts/check-repository.ts",
    "eval:ai": "node --experimental-strip-types scripts/eval-ai.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.19.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.5",
    "framer-motion": "^14.0.0",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "leaflet": "1.9.4",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.5"
  }
}
